{
	"default": {
		"analyzer": {
			"skip_excluded": true
		},
		"excludes": {
            "scopes": [
				{
					"pattern": "devDependencies.*",
					"reason": "TEST_DEPENDENCY_OF",
					"comment": "Dev/Test Dependencies"
				},
				{
					"pattern": "test.*",
					"reason": "TEST_DEPENDENCY_OF",
					"comment": "Dev/Test Dependencies"
				}
			],
            "paths": [
				{
					"pattern": "**/__tests__/**",
					"reason": "TEST_OF",
					"comment": "Common Test Directory"
				},
				{
					"pattern": "scripts/**",
					"reason": "BUILD_TOOL_OF",
					"comment": "Common scripting directory not included in final build"
				}
			]
        }
	},
	"api-layer": {
		"toolsEnabled": ["GradleInspector","NPM"],
		"excludes": {
			"paths": [
				{
					"pattern": "onboarding-enabler-nodejs-sample-app/**",
					"reason": "EXAMPLE_OF",
					"comment": "Sample project causes a duplicate dependency result in ORT, crashing the scan."
				},
				{
					"pattern": "zss-sample-service/**",
					"reason": "EXAMPLE_OF",
					"comment": "Sample project."
				}
			]
		}
	},
	"cics-for-zowe-client": {
		"analyzer": {
			"package_managers": {
				"NPM": {
					"options": {"legacyPeerDeps": true}
				}
			}
		}
	},
	"sample-angular-app": {
		"analyzer": {
			"allow_dynamic_versions": true
		}
	},
	"sample-iframe-app": {
		"analyzer": {
			"allow_dynamic_versions": true
		}
	},
	"sample-react-app": {
		"analyzer": {
			"allow_dynamic_versions": true
		}
	},
	"zowe-cli-db2-plugin": {
		"analyzer": {
			"package_managers": {
				"NPM": {
					"options": {"legacyPeerDeps": true}
				}
			}
		}
	},
	"zowe-cli-ftp-plugin": {
		"analyzer": {
			"package_managers": {
				"NPM": {
					"options": {"legacyPeerDeps": true}
				}
			}
		}
	},
	"zowe-cli-mq-plugin": {
		"analyzer": {
			"package_managers": {
				"NPM": {
					"options": {"legacyPeerDeps": true}
				}
			}
		}
	},
	"zowe-client-python-sdk": {
		"excludes": {
			"paths": [
				{
					"pattern": "samples/**",
					"reason": "EXAMPLE_OF",
					"comment": "Sample project"
				},
				{
					"pattern": "docs/**",
					"reason": "EXAMPLE_OF",
					"comment": "project documentation"
				},
				{
					"pattern": "tests/**",
					"reason": "TEST_OF",
					"comment": "test cases"
				}
			]
		}
	},
	"zowe-explorer-vscode": {
		"excludes": {
			"paths": [
				{
					"pattern": "**/samples/**",
					"reason": "EXAMPLE_OF",
					"comment": "Sample APIs"
				},
				{
					"pattern": "**/zedc/**",
					"reason": "TEST_TOOL_OF",
					"comment": "Development CLI"
				}
			]
		}
	},
	"zowex": {
		"excludes": {
			"paths": [
				{
					"pattern": "**/examples/**",
					"reason": "EXAMPLE_OF",
					"comment": "Demo projects for native testing"
				},
				{
					"pattern": "**/python/app/**",
					"reason": "EXAMPLE_OF",
					"comment": "Sample REST API not published"
				},
				{
					"pattern": "**/python/bindings/test/**",
					"reason": "TEST_TOOL_OF",
					"comment": "Test project for Python bindings"
				}
			]
		}
	}
}
