{
	"default": {
		"excludes": {
            "scopes": [{
                "pattern": "devDependencies.*",
                "reason": "TEST_DEPENDENCY_OF",
                "comment": "Dev/Test Dependencies"
            }, {
                "pattern": "test.*",
                "reason": "TEST_DEPENDENCY_OF",
                "comment": "Dev/Test Dependencies"
            }],
            "paths": [{
                "pattern": "**/__tests__/**",
                "reason": "TEST_OF",
                "comment": "Common Test Directory"
            }, {
                "pattern": "scripts/**",
                "reason": "BUILD_TOOL_OF",
                "comment": "Common scripting directory not included in final build"
            }
            ]
        }
	},
	"api-layer": {
		"excludes": {
			"paths": [
				{
					"pattern": "zss-sample-service/**",
					"reason": "EXAMPLE_OF",
					"comment": "Sample project."
				}
			]
		}
	},
	"sample-angular-app": {	
		"analyzer": {
			"allow_dynamic_versions": true
		}
	},
	"sample-iframe-app": {	
		"analyzer": {
			"allow_dynamic_versions": true
		}
	},
	"sample-react-app": {	
		"analyzer": {
			"allow_dynamic_versions": true
		}
	},
	"zowe-cli": {
	},
	"zowe-client-python-sdk": {
		"excludes": {
			"paths": [
				{
					"pattern": "samples/**",
					"reason": "EXAMPLE_OF",
					"comment": "Sample project"
				}, 
				{
					"pattern": "docs/**",
					"reason": "EXAMPLE_OF",
					"comment": "project documentation"
				}, 
				{
					"pattern": "tests/**",
					"reason": "TEST_OF",
					"comment": "test cases"
				}
			]
		}
	},
	"zowe-explorer-vscode": {
		"excludes": {
			"paths": [
				{
					"pattern": "**/samples/**",
					"reason": "EXAMPLE_OF",
					"comment": "Sample APIs"
				},
				{
					"pattern": "**/zedc/**",
					"reason": "TEST_TOOL_OF",
					"comment": "Development CLI"
				}
			]
		}
	}
}
